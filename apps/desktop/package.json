{
  "name": "@mmap/desktop",
  "productName": "mmap",
  "version": "0.1.0",
  "private": true,
  "description": "mmap desktop application (Electron main, preload and React renderer).",
  "author": "mmap contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --win --x64 --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --win --x64 --dir --config electron-builder.yml",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@mmap/contracts": "0.1.0",
    "@mmap/domain": "0.1.0",
    "@mmap/storage-sqlite": "0.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "katex": "0.18.11",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "cytoscape": "3.34.3",
    "elkjs": "0.12.1"
  }
}
